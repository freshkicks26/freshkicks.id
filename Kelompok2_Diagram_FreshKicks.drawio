        <mxCell id="v25" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" value="Node 1: baca name, email, pass dari form&lt;br&gt;Node 2: if (!name || !email || !pass)&lt;br&gt;Node 3: err = &amp;quot;Semua field wajib diisi&amp;quot;; return&lt;br&gt;Node 4: if (pass.length &amp;lt; 6)&lt;br&gt;Node 5: err = &amp;quot;Password minimal 6 karakter&amp;quot;; return&lt;br&gt;Node 6: try { createUser; updateProfile; setDoc; err = &#39;&#39; }&lt;br&gt;Node 7: catch(e): if (e.code === &#39;auth/email-already-in-use&#39;)&lt;br&gt;Node 8: err = &amp;quot;Email sudah terdaftar&amp;quot;&lt;br&gt;Node 9: err = &amp;quot;Gagal daftar, coba lagi&amp;quot;&lt;br&gt;Node 10: finally { hideLoading() } — selesai" vertex="1">
          <mxGeometry height="190" width="360" x="520" as="geometry" />
        </mxCell>
        <mxCell id="v26" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" value="Cyclomatic Complexity&lt;br&gt;V(G) = E − N + 2 = 13 − 10 + 2 = &lt;b&gt;5&lt;/b&gt;&lt;br&gt;V(G) = P + 1 = 4 predikat + 1 = &lt;b&gt;5&lt;/b&gt;&lt;br&gt;&lt;br&gt;Basis path:&lt;br&gt;P1: 1-2-3-10&lt;br&gt;P2: 1-2-4-5-10&lt;br&gt;P3: 1-2-4-6-10&lt;br&gt;P4: 1-2-4-6-7-8-10&lt;br&gt;P5: 1-2-4-6-7-9-10" vertex="1">
          <mxGeometry height="190" width="360" x="520" y="210" as="geometry" />
        </mxCell>
        <mxCell id="v27" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;fontStyle=1;fontSize=11;spacingLeft=8;spacingTop=4;fontColor=#000000;" value="KETERANGAN SIMBOL" vertex="1">
