        <mxCell id="MjFaSgXWmkWkhtKsqaPc-23" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;strokeColor=none;fillColor=none;" value="&lt;span style=&quot;color:#666666;font-size:14px;&quot;&gt;Registrasi / login / logout&lt;/span&gt;" vertex="1">
