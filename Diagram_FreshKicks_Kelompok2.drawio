        <mxCell id="YzwjBHflB5CboDdGtWTV-53" parent="1" style="text;html=1;align=right;verticalAlign=middle;fontSize=14;fontColor=#111111;strokeColor=none;fillColor=none;" value="0..*" vertex="1">
          <mxGeometry height="22" width="40" x="534" y="608" as="geometry" />
        </mxCell>
        <mxCell id="YzwjBHflB5CboDdGtWTV-54" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#999999;fontSize=13;fontStyle=2;fontColor=#444444;align=center;verticalAlign=middle;" value="Method merepresentasikan responsibility/model operation pada level domain; source code FreshKicks bersifat prosedural/vanilla JavaScript dan tidak menggunakan class OOP literal." vertex="1">
          <mxGeometry height="62" width="900" x="80" y="950" as="geometry" />
        </mxCell>
        <mxCell id="YzwjBHflB5CboDdGtWTV-55" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;strokeColor=none;fillColor=none;" value="Keterangan Class Diagram — Sistem FreshKicks" vertex="1">
          <mxGeometry height="36" width="540" x="1090" y="70" as="geometry" />
        </mxCell>
        <mxCell id="YzwjBHflB5CboDdGtWTV-56" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#222222;strokeColor=none;fillColor=none;" value="&lt;ol style=&quot;margin:0;padding-left:26px;&quot;&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Address&lt;/b&gt; (Value Object / Entity Data) menyimpan name, phone, street, city, zip, dan note; tidak memiliki method.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;User&lt;/b&gt; (Entity) merepresentasikan akun pelanggan: uid (Document ID / Firebase Auth UID), name, email, points, createdAt, dan alamat [0..1]. Method: register(), login(), logout(), tambahPoin(), kurangiPoin(), simpanAlamat().&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Order&lt;/b&gt; (Entity) merepresentasikan pesanan: uid (FK → User.uid), brand, type, color, phone, alamat [0..1], note, service, price, delivery, deliveryPrice, total, status, dan createdAt. Method: hitungTotal() dan perbaruiStatus().&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Atribut status bernilai salah satu dari Masuk, Inspeksi, Proses, Pengeringan, Selesai, atau Dibatalkan.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Relasi &lt;b&gt;User 1 — 0..* Order&lt;/b&gt;: satu pelanggan dapat memiliki nol atau banyak order (Order.uid mengacu ke User.uid).&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Relasi komposisi (belah ketupat hitam) antara Address dengan User dan antara Address dengan Order, multiplicity 0..1: User maupun Order menyimpan paling banyak satu alamat.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="400" width="540" x="1090" y="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
