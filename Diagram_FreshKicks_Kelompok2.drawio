        <mxCell id="M5Hwgpgs5MmQ2QsOHI9O-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;h3&gt;Keterangan Activity Diagram Booking Layanan&lt;/h3&gt;&lt;h3&gt;&lt;p&gt;Activity Diagram Booking Layanan menggambarkan tahapan pelanggan dalam melakukan pemesanan layanan perawatan sepatu melalui FreshKicks.&lt;/p&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;p&gt;Pelanggan membuka halaman booking layanan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Pelanggan memilih layanan dan mengisi detail pemesanan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem memvalidasi data booking yang dimasukkan pelanggan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika data tidak valid, sistem meminta pelanggan memperbaiki data pemesanan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika data valid, sistem melanjutkan proses penyimpanan pesanan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem menyimpan data pesanan ke Firestore.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika penyimpanan gagal, sistem menampilkan informasi bahwa booking gagal.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika penyimpanan berhasil, sistem memberikan tambahan 30 poin kepada pelanggan sesuai mekanisme yang diterapkan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem memperbarui informasi poin pelanggan dan menampilkan konfirmasi booking.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Pelanggan dapat melanjutkan ke halaman tracking untuk melihat status pesanan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Proses booking selesai.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="445" width="898" x="1093" y="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
