        <mxCell id="r0L5NfqJwGflE0dS5ry0-43" parent="8Lw6jq9XIkaicwB4oaUY-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#222222;strokeColor=none;fillColor=none;" value="&lt;ol style=&quot;margin:0;padding-left:26px;&quot;&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Pelanggan memilih reward dan menekan tombol “Tukar”.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Client memeriksa apakah saldo poin mencukupi biaya reward.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;alt [Poin cukup]&lt;/b&gt;: Client menampilkan loading, mengurangi saldo poin, lalu meminta Firestore memperbarui poin pelanggan.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;alt bersarang [Penyimpanan berhasil]&lt;/b&gt;: Firestore mengembalikan “berhasil”; Client memperbarui tampilan poin, mencatat riwayat penukaran, dan menampilkan “Berhasil tukar reward”.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;else [Penyimpanan gagal]&lt;/b&gt;: Firestore mengembalikan exception dan Client menampilkan “Gagal tukar poin”.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;else [Poin tidak cukup]&lt;/b&gt;: Client langsung menampilkan “Poin tidak cukup!” tanpa memanggil Firestore.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Reward yang tersedia: Gratis Deep Clean (200 poin), Gratis Ongkir 3x (300 poin), Diskon 50% (500 poin), Gratis Premium Care (1.000 poin).&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="328" width="560" x="1660" y="148" as="geometry" />
        </mxCell>
        <mxCell id="r0L5NfqJwGflE0dS5ry0-44" parent="8Lw6jq9XIkaicwB4oaUY-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=2;fontColor=#555555;strokeColor=none;fillColor=none;" value="Login (UC-02) sudah terpenuhi sebelum UC-09, sehingga Firebase Authentication tidak digambarkan. Penukaran berjalan otomatis tanpa persetujuan Admin (BR-09); riwayat penukaran hanya tersimpan sementara di browser." vertex="1">
          <mxGeometry height="73" width="560" x="1660" y="490" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
