        <mxCell id="9B5hOwIOmMYWMwtswTOc-54" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;strokeColor=none;fillColor=none;" value="Keterangan Sequence Diagram UC-14 — Memperbarui Status Order" vertex="1">
          <mxGeometry height="64" width="560" x="2060" y="80" as="geometry" />
        </mxCell>
        <mxCell id="9B5hOwIOmMYWMwtswTOc-55" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#222222;strokeColor=none;fillColor=none;" value="&lt;ol style=&quot;margin:0;padding-left:26px;&quot;&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Admin/Owner memilih metode update status pada order: Quick Update atau Update via Modal.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Client menampilkan indikator loading.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Client meminta Firestore memperbarui status order.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;alt [Update Firestore berhasil]&lt;/b&gt;: Firestore mengembalikan “berhasil”, lalu Client menyiapkan pesan WhatsApp.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;alt bersarang [Nomor WA tersedia &amp; pengiriman berhasil]&lt;/b&gt;: Client mengirim notifikasi WhatsApp ke Fonnte dan Fonnte mengembalikan “Berhasil terkirim”.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;else [Nomor WA kosong / pengiriman gagal]&lt;/b&gt;: jika nomor tersedia tetapi pengiriman gagal, Fonnte mengembalikan “Gagal”; jika nomor WA kosong, Client tidak memanggil Fonnte dan langsung mencatat status gagal.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Setelah cabang WhatsApp selesai, Client mencatat log WA, menampilkan hasil update, memperbarui dashboard, dan perubahan status tersedia untuk tracking realtime pelanggan.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;else [Update Firestore gagal]&lt;/b&gt;: Firestore mengembalikan “Gagal / exception” dan Client menampilkan “Gagal update status”. Notifikasi WhatsApp tidak dikirim.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="436" width="560" x="2060" y="148" as="geometry" />
        </mxCell>
        <mxCell id="9B5hOwIOmMYWMwtswTOc-56" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=2;fontColor=#555555;strokeColor=none;fillColor=none;" value="Jika WhatsApp gagal, status order tetap berhasil diperbarui (tidak ada rollback). Pelanggan tidak digambarkan sebagai participant; ia hanya menerima dampaknya melalui tracking realtime." vertex="1">
          <mxGeometry height="73" width="560" x="2060" y="598" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
