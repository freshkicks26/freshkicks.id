          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PHbaRa5D2CZHJEJfKZ-2-32" edge="1" parent="xHsfmhKLrCceHjCjnMPg-1" source="PHbaRa5D2CZHJEJfKZ-2-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="PHbaRa5D2CZHJEJfKZ-2-16" value="Tidak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PHbaRa5D2CZHJEJfKZ-2-33" edge="1" parent="xHsfmhKLrCceHjCjnMPg-1" source="PHbaRa5D2CZHJEJfKZ-2-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="PHbaRa5D2CZHJEJfKZ-2-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PHbaRa5D2CZHJEJfKZ-2-34" parent="xHsfmhKLrCceHjCjnMPg-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;strokeColor=none;fillColor=none;" value="Keterangan Activity Diagram — Tracking Order (UC-05)" vertex="1">
          <mxGeometry height="64" width="540" x="1110" y="40" as="geometry" />
        </mxCell>
        <mxCell id="PHbaRa5D2CZHJEJfKZ-2-35" parent="xHsfmhKLrCceHjCjnMPg-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#222222;strokeColor=none;fillColor=none;" value="&lt;ol style=&quot;margin:0;padding-left:26px;&quot;&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Pelanggan membuka menu Tracking.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Sistem memeriksa apakah pelanggan sudah login (D1). Jika belum, proses tidak dapat dilanjutkan dan berakhir.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Jika sudah login, Sistem membaca order milik pelanggan dari Firestore secara realtime menggunakan listener onSnapshot (filter uid pelanggan, urutan terbaru di atas).&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Sistem memeriksa apakah ada order (D2). Jika tidak ada, Sistem menampilkan pesan “Belum ada order” dan proses berakhir.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Jika ada order, Sistem menampilkan daftar order (terbaru di atas) lengkap dengan badge status.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Sistem menampilkan timeline status tiap order: Masuk → Inspeksi → Proses → Pengeringan → Selesai. Order berstatus Dibatalkan ditampilkan dengan semua langkah timeline belum tercapai (abu-abu).&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Sistem memeriksa apakah ada perubahan status order (D3). Jika Admin/Owner memperbarui status, Sistem menerima perubahan dari Firestore (onSnapshot) dan memperbarui daftar serta timeline otomatis tanpa refresh, lalu kembali memeriksa perubahan berikutnya.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;Jika tidak ada perubahan, Pelanggan melihat status order terbaru dan proses berakhir.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="456" width="540" x="1110" y="108" as="geometry" />
        </mxCell>
        <mxCell id="PHbaRa5D2CZHJEJfKZ-2-36" parent="xHsfmhKLrCceHjCjnMPg-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=2;fontColor=#555555;strokeColor=none;fillColor=none;" value="Listener realtime tetap aktif selama sesi login dan dihentikan saat logout. Daftar yang sama juga memuat order berstatus Selesai/Dibatalkan (riwayat order, UC-06)." vertex="1">
          <mxGeometry height="73" width="540" x="1110" y="578" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
