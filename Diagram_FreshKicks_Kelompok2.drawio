          <mxGeometry height="30" width="60" x="1030" y="401" as="geometry" />
        </mxCell>
        <mxCell id="lKxZyzYKhVA2p0xjSWIp-90" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);" value="&lt;font style=&quot;&quot;&gt;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="80" y="401" as="geometry" />
        </mxCell>
        <mxCell id="lKxZyzYKhVA2p0xjSWIp-96" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#FFFFFF);fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);" value="&lt;font style=&quot;font-size: 42px;&quot;&gt;SISTEM FRESHKICKS&lt;/font&gt;" vertex="1">
          <mxGeometry height="89" width="565" x="302" y="26" as="geometry" />
        </mxCell>
        <mxCell id="NaFAB-IZq_lyQyCRZxCM-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);" value="&lt;h3&gt;&lt;span style=&quot;&quot;&gt;Keterangan Use Case Diagram FreshKicks&lt;/span&gt;&lt;/h3&gt;&lt;p&gt;&lt;span style=&quot;&quot;&gt;Use Case Diagram FreshKicks menggambarkan interaksi antara dua aktor, yaitu &lt;strong&gt;Pelanggan&lt;/strong&gt; dan &lt;strong&gt;Admin/Owner&lt;/strong&gt;, dengan sistem FreshKicks. Setiap aktor memiliki hak akses dan fungsi yang berbeda sesuai dengan perannya.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;&quot;&gt;1. Pelanggan&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;&quot;&gt;Pelanggan dapat melakukan registrasi akun dan login ke dalam sistem. Setelah berhasil masuk, pelanggan dapat melakukan booking layanan perawatan sepatu, memantau status pesanan, melihat riwayat order, mengelola alamat pengiriman, mengumpulkan dan menukarkan poin, serta melihat dan mengelola profil akun.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;&quot;&gt;2. Admin/Owner&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;&quot;&gt;Admin/Owner dapat login ke sistem untuk mengakses fitur pengelolaan layanan. Fitur tersebut meliputi melihat daftar order, memperbarui status order, mengirimkan notifikasi melalui WhatsApp, melihat dashboard statistik, dan melihat daftar pelanggan.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;&quot;&gt;3. Logout&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;&quot;&gt;Fitur logout digunakan oleh Pelanggan maupun Admin/Owner untuk mengakhiri sesi penggunaan sistem setelah selesai melakukan aktivitas.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;&quot;&gt;4. Hubungan antar Use Case&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;&quot;&gt;Hubungan antar use case menunjukkan keterkaitan antara fungsi-fungsi di dalam sistem. Proses booking layanan berkaitan dengan pemberian poin kepada pelanggan, sedangkan pembaruan status order berkaitan dengan pengiriman notifikasi WhatsApp.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;&quot;&gt;5. Tujuan Sistem&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;&quot;&gt;Use Case Diagram ini digunakan untuk memberikan gambaran umum mengenai fungsi utama FreshKicks dan interaksi setiap aktor dengan sistem sebelum proses perancangan yang lebih terperinci dilakukan.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="428" width="900" x="1212" y="374" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
