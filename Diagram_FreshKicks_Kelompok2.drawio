        <mxCell id="icd26upkOsoUmuGadpmJ-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&#xa;&lt;h3&gt;&lt;span&gt;Keterangan Sequence Diagram Booking Layanan&lt;/span&gt;&lt;/h3&gt;&lt;p&gt;&lt;span&gt;Sequence Diagram Booking Layanan menggambarkan urutan interaksi antara pelanggan, FreshKicks UI (Client), dan Firestore dalam proses pemesanan layanan.&lt;/span&gt;&lt;/p&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Pelanggan memilih detail sepatu dan memasukkan informasi layanan yang akan dipesan.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Pelanggan memilih layanan dan metode pengiriman.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Client menampilkan ringkasan dan konfirmasi pemesanan kepada pelanggan.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Pelanggan menekan tombol konfirmasi booking.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Client mengirimkan data pesanan untuk disimpan ke Firestore.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Jika penyimpanan berhasil, Firestore memberikan respons bahwa data pesanan berhasil disimpan.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Client memproses penambahan 30 poin kepada pelanggan dan memperbarui data poin.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Client memperbarui tampilan poin serta mencatat riwayat poin sesuai mekanisme yang diterapkan.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Client menampilkan pesan bahwa booking berhasil.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Client mengarahkan pelanggan ke halaman tracking order agar pelanggan dapat memantau status pesanannya.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Jika penyimpanan pesanan gagal, sistem menampilkan pesan bahwa booking gagal dan pelanggan dapat mencoba kembali.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;span&gt;Proses booking selesai.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&#xa;&#xa;" vertex="1">
          <mxGeometry height="410" width="877" x="1742" y="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
