        </mxCell>
        <mxCell id="MjFaSgXWmkWkhtKsqaPc-24" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;strokeColor=none;fillColor=none;" value="&lt;span style=&quot;color:#111111;font-size:14px;&quot;&gt;HTTPS / Firestore SDK&lt;/span&gt;" vertex="1">
          <mxGeometry height="22" width="241" x="592" y="662" as="geometry" />
        </mxCell>
        <mxCell id="MjFaSgXWmkWkhtKsqaPc-25" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;strokeColor=none;fillColor=none;" value="&lt;span style=&quot;color:#666666;font-size:14px;&quot;&gt;Baca &amp; tulis users, orders&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:14px;&quot;&gt;(termasuk onSnapshot realtime)&lt;/span&gt;" vertex="1">
          <mxGeometry height="44" width="241" x="592" y="752" as="geometry" />
        </mxCell>
        <mxCell id="MjFaSgXWmkWkhtKsqaPc-26" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;strokeColor=none;fillColor=none;" value="&lt;span style=&quot;color:#111111;font-size:14px;&quot;&gt;HTTPS POST&lt;/span&gt;" vertex="1">
          <mxGeometry height="22" width="225" x="856" y="662" as="geometry" />
        </mxCell>
        <mxCell id="MjFaSgXWmkWkhtKsqaPc-27" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;strokeColor=none;fillColor=none;" value="&lt;span style=&quot;color:#666666;font-size:14px;&quot;&gt;Kirim notifikasi WA&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#666666;font-size:14px;&quot;&gt;(khusus Admin Panel)&lt;/span&gt;" vertex="1">
          <mxGeometry height="44" width="225" x="856" y="756" as="geometry" />
        </mxCell>
        <mxCell id="MjFaSgXWmkWkhtKsqaPc-30" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#222222;strokeColor=none;fillColor=none;" value="Keterangan Deployment Diagram — Sistem FreshKicks" vertex="1">
          <mxGeometry height="64" width="540" x="1140" y="70" as="geometry" />
        </mxCell>
        <mxCell id="MjFaSgXWmkWkhtKsqaPc-31" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#222222;strokeColor=none;fillColor=none;" value="&lt;ol style=&quot;margin:0;padding-left:26px;&quot;&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Client Device&lt;/b&gt; (web browser / PWA) digunakan oleh Pelanggan dan Admin Panel, dan terhubung ke layanan lain melalui Internet (HTTPS).&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Netlify&lt;/b&gt; (static hosting / CDN) menyimpan artifact index.html, admin.html, manifest.json, sw.js, dan logo.png; klien mengunduh frontend/PWA melalui HTTPS port 443.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Firebase Authentication&lt;/b&gt; (layanan cloud eksternal) menangani registrasi, login, dan logout melalui HTTPS.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Cloud Firestore&lt;/b&gt; (database, layanan cloud eksternal) menyimpan koleksi users dan orders; baca dan tulis melalui HTTPS / Firestore SDK, termasuk onSnapshot realtime.&lt;/li&gt;&lt;li style=&quot;margin-bottom:8px;&quot;&gt;&lt;b&gt;Fonnte WhatsApp API&lt;/b&gt; (layanan cloud eksternal) menerima permintaan HTTPS POST untuk mengirim notifikasi WhatsApp, hanya dipanggil dari Admin Panel.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="312" width="540" x="1140" y="138" as="geometry" />
        </mxCell>
        <mxCell id="MjFaSgXWmkWkhtKsqaPc-32" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=2;fontColor=#555555;strokeColor=none;fillColor=none;" value="Fonnte dipanggil langsung dari client-side Admin Panel; API token masih berada pada kode client dan secure secret management belum diterapkan. RBAC belum diimplementasikan." vertex="1">
          <mxGeometry height="73" width="540" x="1140" y="464" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
