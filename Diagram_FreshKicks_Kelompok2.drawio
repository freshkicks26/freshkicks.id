        </mxCell>
        <mxCell id="iG4_8HwsmW6sUK41s4Ld-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;h3&gt;Keterangan Activity Diagram Update Status Order&lt;/h3&gt;&lt;h3&gt;&lt;p&gt;Activity Diagram Update Status Order menggambarkan proses admin dalam memperbarui status pesanan pelanggan melalui sistem FreshKicks.&lt;/p&gt;&lt;ol start=&quot;1&quot;&gt;&lt;li&gt;&lt;p&gt;Admin membuka halaman pengelolaan order.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem menampilkan daftar order yang tersedia.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Admin memilih order yang akan diperbarui.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem menampilkan informasi detail order.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Admin memilih status baru untuk pesanan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem memeriksa pilihan status yang dimasukkan admin.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika proses pembaruan dibatalkan, sistem kembali ke halaman sebelumnya tanpa menyimpan perubahan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika status telah dipilih, sistem memperbarui data order di Firestore.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika penyimpanan gagal, sistem menampilkan informasi kegagalan pembaruan.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika penyimpanan berhasil, sistem menampilkan status terbaru pada daftar order.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Sistem mencoba mengirimkan notifikasi WhatsApp kepada pelanggan melalui layanan Fonnte.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Jika notifikasi berhasil, pelanggan menerima informasi perubahan status melalui WhatsApp. Jika pengiriman gagal, status order yang sudah tersimpan tetap berlaku.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Proses pembaruan status selesai.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="524" width="607" x="1124" y="64" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
